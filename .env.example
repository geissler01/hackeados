# ===================================================
# CONFIGURACIÓN DEL ENTORNO - HACKEADOS
# Dominio de Producción: https://hackeados.geislera.com
# API / WebSockets: https://api-hackeados.geislera.com
# ===================================================

# 1. BASE DE DATOS (PostgreSQL en Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=hackeados_admin
DB_PASSWORD=hackeados_secret_2026
DB_NAME=hackeados_db

# 2. SERVIDOR BACKEND (NestJS)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,https://hackeados.geislera.com

# 3. PROVEEDORES DE INTELIGENCIA ARTIFICIAL (Gratuitos)
# Obtén tu clave gratuita de Groq en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Obtén tu clave gratuita de Google Gemini en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# 4. PARÁMETROS DEL JUEGO
MAX_QUESTIONS_PER_CATEGORY=200
MATCH_QUESTIONS_COUNT=120
ROOM_CODE_LENGTH=6
HOST_GRACE_PERIOD_MS=10000
