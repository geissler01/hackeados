# ===================================================
# CONFIGURACIÓN DEL ENTORNO - HACKEADOS
# Dominio Frontend: https://hackeados.geislera.com
# API / WebSockets: https://hackeados.api.geislera.com
# ===================================================

# 1. PUERTOS DEL SISTEMA (Configurables)
# Puerto en el Host VPS para el Backend (Nginx redirige aquí)
APP_HOST_PORT=3001
# Puerto interno del contenedor NestJS
PORT=3000

# Puerto local en el Host VPS para PostgreSQL (solo accesible vía 127.0.0.1 / DBeaver SSH)
DB_HOST_PORT=5441
# Puerto interno del contenedor PostgreSQL
DB_PORT=5432

# 2. BASE DE DATOS (PostgreSQL)
# En la VPS con Docker usar DB_HOST=postgres
# En local conectado a la VPS usar DB_HOST=<IP_O_DOMINIO_VPS>
DB_HOST=postgres
DB_USER=hackeados_admin
DB_PASSWORD=tu_password_seguro_aqui
DB_NAME=hackeados_db

# 3. SERVIDOR BACKEND (NestJS)
NODE_ENV=production
CORS_ORIGIN=https://hackeados.geislera.com,http://localhost:4200,http://127.0.0.1:4200

# 4. PROVEEDORES DE INTELIGENCIA ARTIFICIAL (Gratuitos)
# Obtén tu clave gratuita de Groq en: https://console.groq.com/keys
GROQ_API_KEY=tu_clave_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Obtén tu clave gratuita de Google Gemini en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# 5. PARÁMETROS DEL JUEGO
MAX_QUESTIONS_PER_CATEGORY=200
MATCH_QUESTIONS_COUNT=120
ROOM_CODE_LENGTH=6
HOST_GRACE_PERIOD_MS=20000
